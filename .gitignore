.DS_Store

# Local secrets — never commit API keys
.env
.env.local

# MCP server build output and dependencies
mcp-servers/*/node_modules/
mcp-servers/*/dist/

# Rendered görseller HTML'den yeniden üretilebiliyor; kaynak HTML commit'li,
# PNG'ler değil. Portreler ise başkasının telifi — repoya girmiyor.
content/out/
content/*/photos/*
!content/*/photos/.gitkeep
!content/*/photos/*.sh

# Gönderi klasörüne bırakılan görseller de telifli olabilir — indir.sh oradan
# da okuyor, dolayısıyla oraya düşmeleri olağan.
content/*/*.jpg
content/*/*.jpeg
content/*/*.png
content/*/*.webp
content/*/*.avif

