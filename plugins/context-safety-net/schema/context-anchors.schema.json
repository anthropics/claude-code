{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "anchors"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "priority", "reason"],
        "properties": {
          "path": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium"]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}